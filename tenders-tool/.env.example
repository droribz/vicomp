# ============================================================================
#  אישורי גישה למקורות שדורשים התחברות.
#  העתק קובץ זה ל-.env (cp .env.example .env) ומלא את הערכים.
#  קובץ .env לעולם לא נכנס ל-git (ראה .gitignore).
#  מקור שאין לו פרטים כאן — פשוט יידלג בצורה נקייה (לא יפיל את הסריקה).
# ============================================================================

# --- מינהל הרכש הממשלתי (mr.gov.il) ---------------------------------------
# הרשמה חינם באתר: https://mr.gov.il/ilgstorefront/he/  (לחצן "הרשמה")
# לאחר ההרשמה מלא כאן את אותם שם משתמש + סיסמה:
MRGOV_USERNAME=
MRGOV_PASSWORD=

# --- הוסף כאן מקורות נוספים שדורשים התחברות בעתיד -------------------------
# EXAMPLE_USERNAME=
# EXAMPLE_PASSWORD=
